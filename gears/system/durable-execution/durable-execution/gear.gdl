gdl_version = "1.0"

# Every GDL field: https://github.com/constructorfabric/gearbox/blob/main/docs/gdl.md
#
# Gearbox product metadata for the durable-execution gear.
#
# Projected from #[toolkit::gear] in src/gear.rs: id, runtime_caps (db,
# stateful, system, rest) and lifecycle; deps below is an exact checked mirror
# (GBX0214).

gear(
    deps = ["authn-resolver", "authz-resolver"],
    source = git(url = "https://github.com/constructorfabric/gears-rust", path = "gears/system/durable-execution/durable-execution"),
    maturity = "experimental",
    implementation = "in-progress",
    name = "Durable Execution",
    description = "Typed Rust workflows with durable checkpoints, fan-out, retries and saga compensation.",
    category = "serverless",
    visibility = "internal",

    package = cargo(
        crate_name = "cf-gears-durable-execution",
        lib = "cf_gears_durable_execution",
        path = ".",
    ),

    sdk = cargo(
        crate_name = "cf-gears-durable-execution-sdk",
        lib = "cf_gears_durable_execution_sdk",
        path = "../durable-execution-sdk",
    ),

    # Whether this process runs activities and delivers tasks, and where its
    # queue lives; the timing fields are edited in the configuration file.
    config_schema = config(exposes = ["execute_activities", "delivery_enabled", "queue_database_url_env", "default_queue"]),

    # `integration` is test scaffolding (PostgreSQL recovery tests) and is not
    # offered.
    cargo_features = [],
)
